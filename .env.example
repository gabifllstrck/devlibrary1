# Copie este arquivo para ".env" e preencha com os SEUS dados.
# O arquivo .env NUNCA deve ser enviado ao GitHub.

PORT=3000

# Dados de conexão com o MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=coloque_sua_senha_do_mysql_aqui
DB_NAME=devlibrary
DB_SSL=false
# Para bancos com CA própria, configure DB_SSL_CA no ambiente sem commitar o certificado.

# Texto longo e aleatório usado para assinar os logins (tokens JWT).
# Troque por qualquer frase grande e secreta.
JWT_SECRET=troque-esta-frase-por-algo-bem-longo-e-secreto

# Regras da biblioteca
DIAS_EMPRESTIMO=14
MAX_EMPRESTIMOS_ATIVOS=3
